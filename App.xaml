<Application x:Class="CtrlHanabi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <!-- ===== Space tokens ===== -->
        <Thickness x:Key="Space1">4</Thickness>
        <Thickness x:Key="Space2">8</Thickness>
        <Thickness x:Key="Space3">12</Thickness>
        <Thickness x:Key="Space4">16</Thickness>
        <Thickness x:Key="Space6">24</Thickness>

        <sys:Double x:Key="Space1.Value">4</sys:Double>
        <sys:Double x:Key="Space2.Value">8</sys:Double>
        <sys:Double x:Key="Space3.Value">12</sys:Double>
        <sys:Double x:Key="Space4.Value">16</sys:Double>
        <sys:Double x:Key="Space6.Value">24</sys:Double>

        <!-- ===== Control height token ===== -->
        <sys:Double x:Key="ControlHeight">32</sys:Double>

        <!-- ===== Corner radius tokens ===== -->
        <CornerRadius x:Key="RadiusControl">4</CornerRadius>
        <CornerRadius x:Key="RadiusCard">8</CornerRadius>
        <CornerRadius x:Key="RadiusOverlay">12</CornerRadius>

        <!-- ===== Color tokens (ThemeManager dynamically updates these at runtime) ===== -->
        <SolidColorBrush x:Key="Brush.Surface"      Color="{x:Static SystemColors.WindowColor}"/>
        <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="{x:Static SystemColors.ControlColor}"/>
        <SolidColorBrush x:Key="Brush.Text"         Color="{x:Static SystemColors.WindowTextColor}"/>
        <SolidColorBrush x:Key="Brush.TextMuted"    Color="{x:Static SystemColors.GrayTextColor}"/>
        <SolidColorBrush x:Key="Brush.Border"       Color="{x:Static SystemColors.ActiveBorderColor}"/>
        <SolidColorBrush x:Key="Brush.Accent"       Color="{x:Static SystemColors.HotTrackColor}"/>
        <SolidColorBrush x:Key="Brush.AccentText"   Color="White"/>
        <SolidColorBrush x:Key="Brush.Danger"       Color="Firebrick"/>
        <SolidColorBrush x:Key="Brush.Success"      Color="#107C41"/>

        <!-- Overlay (semi-transparent) -->
        <Color x:Key="Color.Overlay">#CC000000</Color>
        <SolidColorBrush x:Key="Brush.Overlay"      Color="{StaticResource Color.Overlay}"/>

        <!-- ===== Typography ===== -->
        <Style x:Key="TextStyle.Caption" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TextStyle.Body" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TextStyle.Title" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="20"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TextStyle.SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TextStyle.Error" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Control styles ===== -->
        <!-- Primary button -->
        <Style x:Key="ButtonStyle.Primary" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="MinWidth"        Value="80"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.AccentText}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="ButtonStyle.Secondary" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="MinWidth"        Value="80"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Resources>
</Application>
