<Window x:Class="CtrlHanabi.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CtrlHanabi — About"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{x:Static SystemColors.ControlBrush}"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="CtrlHanabi"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{x:Static SystemColors.WindowTextBrush}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{x:Static SystemColors.ControlBrush}"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button Content="{Binding CloseButtonText}"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Height="32" MinWidth="80" Padding="12,0"
                    IsDefault="True" IsCancel="True"/>
        </Border>
        <!-- Content -->
        <StackPanel Margin="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding VersionLabel}"
                           FontSize="14"
                           Foreground="{x:Static SystemColors.WindowTextBrush}"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding VersionText}"
                           FontSize="14"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
